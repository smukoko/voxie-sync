# ==========================================
# VOXIE - CONFIGURATION
# Copy this file to '.env'. As copied it is the FREE route: books are narrated
# on this computer's CPU (Kokoro), the junk filter runs locally, and no paid
# service or API key is used. Every paid option below is optional.
# ==========================================

# --- NARRATION ---------------------------------------------------------------
# kokoro     this computer's CPU, free (server/cpu_tts.py). Preset voices, no
#            cloning. ~3.7x realtime on an M1: a one-hour book in about 16 minutes.
# Voxie narrates English only for now: a book in another language goes to the
# Kobo as an ebook, without audio (core/languages.py).
# cosyvoice  a GPU: your own (TTS_URL below) or rented on RunPod. Clones a
#            voice you add with `voxie voice-add`. See "The GPU route" below.
TTS_PROVIDER=kokoro
# Kokoro's voice (af_heart, American English, by default).
# KOKORO_VOICE=af_heart
# cpu, or mps on Apple Silicon (~20% faster).
# KOKORO_DEVICE=cpu

# --- AUDIOBOOKSHELF CREDENTIALS ---
# Where Audiobookshelf is reachable *from whatever reads this file*.
# This value is used only when you run the gateway directly on your machine
# (python librerian_gateway_v3.py). Inside docker compose it is overridden with
# http://audiobookshelf:80, because 127.0.0.1 there means the gateway container
# itself -- see docker-compose.yml.
ABS_URL=http://127.0.0.1:13378
ABS_API_TOKEN=your_audiobookshelf_api_token_here

# --- UPLOAD TOKEN (REQUIRED on any server with a public IP) ---
# Shared secret between mac_ghost.py and the gateway's /upload endpoint. Port
# 3000 must stay open to the internet for the Kobo to reach it, so without this
# anyone could push files into your library. The gateway refuses ALL uploads
# when it is unset.
#
# `voxie init` generates this and stores it in ~/.librasync.json on the
# Mac, then prints the exact line to paste here. The two must match.
UPLOAD_TOKEN=paste_the_token_that_voxie_init_printed

# --- JUNK FILTER, OPTIONAL PAID HELP ---
# Without a key the local classifier decides alone and keeps whatever it is
# unsure about (it never guesses a section away). With one, Groq settles those
# grey-zone sections. Paid, and it sees those sections' text.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- YOUR OWN GPU (instead of RunPod) ---
# The address of a machine running server/custom_api.py (the docker/cosyvoice
# image). Set it and no RunPod account is needed; --tts-url does the same per run.
# Start the server with the same TTS_API_TOKEN as below: the engine refuses one
# that answers without it.
# TTS_URL=http://localhost:8000
# TTS_URL_WORKERS=8          # fewer on a smaller card

# --- RUNPOD (rented GPU, paid; only with TTS_PROVIDER=cosyvoice) ---
RUNPOD_API_KEY=
# `voxie init` writes Voxie's public template here (y1s4i5a5qa, cosyvoice-tts:4.1).
RUNPOD_TEMPLATE_ID=
# Must contain a literal "{pod_id}" placeholder — the engine substitutes the
# deployed pod's ID into it at runtime (librerian_engine_v3.py: url_pattern.format(pod_id=...)).
# Check your RunPod template's exposed port/proxy URL for the correct value.
RUNPOD_URL_PATTERN=

# Ceiling on the generation phase once the pod is serving, in seconds.
# Default 28800 (8h). It has to exceed the longest book you will drop at the
# provider's measured throughput: CosyVoice runs ~3.4x realtime, so a 16-hour
# novel is ~4.7 hours of generation. Too low and the run aborts mid-book after
# the GPU has already been paid for.
# GENERATION_TIMEOUT_SECONDS=28800

# How the engine reaches the pod's TTS server.
#
#   proxy  (default) https://<pod>-8000.proxy.runpod.net -- RunPod's HTTP proxy.
#          Needs no template change, but sits behind Cloudflare, which kills any
#          response over ~100 seconds. Chunks that are merely slow get killed
#          mid-generation and eventually dropped from the book.
#
#   tcp    http://<ip>:<port> -- RunPod TCP port mapping, straight to the
#          container. No response ceiling. REQUIRES two manual steps:
#            1. change the RunPod template to expose 8000 as TCP, not HTTP
#            2. set TTS_API_TOKEN below (`voxie init` makes one). The engine
#               sends it to every pod it starts; the template needs none
#          The engine refuses to start on tcp without a token, because a raw
#          public port has no proxy in front of it and an unauthenticated
#          server is an open GPU for anyone who portscans the host.
# RUNPOD_TRANSPORT=proxy

# Shared secret for the GPU server (cosyvoice). Required for it, on RunPod or
# your own; the CPU route does not need one. Generate: openssl rand -hex 32
TTS_API_TOKEN=


# --- OPENROUTER (paid, optional): for JUNK_PROVIDER=jev or shadow, and the narration director ---
OPENROUTER_API_KEY=

# Machine Learning thresholds (Do not change unless tuning the AI)
ML_LOWER_BOUND=0.05
ML_UPPER_BOUND=0.96

# --- SYSTEM SETTINGS ---
# The port the Gateway server will run on
PORT=3000

# Timezone for the containers (used by docker-compose.yml)
TZ=UTC

# --- CHUNK CACHE ---
# A chunk's audio is a pure function of its text, narrator and model, so the
# same chunk is never paid for twice. A re-run then costs only what changed:
# the Roman-numeral fix alters ~30 of The Screwtape Letters' 153 chunks, so
# regenerating it is ~8 minutes of GPU instead of ~41.
#
# Deliberately outside the repo and outside mfa_workspace, which the engine
# wipes at the start of every run.
# CHUNK_CACHE_DIR=~/.librasync_chunk_cache
#
# Set to 0 to bypass without deleting. This is a correctness escape hatch: if a
# provider ever changes its output without changing its cache_identity, every
# entry for it is wrong and there has to be a way round it.
# CHUNK_CACHE=1

# --- HORIZONTAL PODS ---
# How many GPU pods one book may use. Generation is 72-87% of a book's wall
# clock and one L40S saturates near 3.8x realtime, so this is the only lever
# that goes meaningfully faster: five pods take Screwtape's generation from
# ~41 min to ~8.
#
# Default 1, deliberately. This multiplies the BILL as well as the speed --
# five pods is $5.45/hr while they run -- so it is opt-in rather than something
# discovered by accident. Generation *cost* is roughly flat (same total work,
# fewer minutes), but the boot tax is per pod.
#
# The pool is elastic: if only three of five come up, the book runs on three and
# says so. Workers are spread MAX_WORKERS per pod.
#
# If a run is killed with SIGKILL, its pods are left billing -- no cleanup runs.
# Every pod is recorded in ~/.librasync_active_pods.json at deploy time and
# mac_ghost sweeps it at startup; `python mac_ghost.py --sweep-pods` does it now.
# POD_COUNT=1
#
# What a 16-hour book may cost in all, in dollars (core/cost_plan.py): the GPU
# and what the director and the filters spent on OpenRouter. Only cards
# measured by tools/gpu_bench.py are rented, at prices that keep a book under
# this, cheapest per audio hour first; POD_COUNT is cut to what still fits, and
# the estimate is printed before anything bills. Raise it to allow faster,
# dearer cards.
# VOXIE_BUDGET_16H=1.00
#
# Minutes a pod waits without a request before it terminates itself (the image
# from 4.2 on; 0 = never). It is what stops the bill when this computer sleeps
# or its battery runs out mid-book: on 2026-10-08 that cost $3.63 in four hours.
# POD_IDLE_MINUTES=15
#
# Ceiling on the cache, in GB (0 disables pruning). It doubles the disk a book
# costs -- the working copy in mfa_workspace plus the cached original -- and a
# 16-hour novel is ~5.5GB of chunks. Enforced after a run completes, never
# during one. Default 20.
# CHUNK_CACHE_MAX_GB=20

# --- Junk filter -----------------------------------------------------------
# Which implementation decides a section is the publisher's furniture rather
# than the author's work: ai_brain (XGBoost + Groq), jev (TypeSafe System One),
# or shadow (run both, trust JUNK_PRIMARY, log every disagreement).
JUNK_PROVIDER=ai_brain
# Only read when JUNK_PROVIDER=shadow. The primary decides the book; the
# shadow only ever writes to the log, so this is safe to leave on for a run.
JUNK_PRIMARY=ai_brain
JUNK_SHADOW=jev
JUNK_SHADOW_LOG=~/librasync_junk_shadow.jsonl
# TypeSafe returns typed decisions with calibrated probabilities, so the cut
# is a number here rather than a prompt. Asymmetric on purpose: narrating a
# copyright page costs ninety seconds, dropping a chapter costs the book.
# JEV is reached through OpenRouter's Decisions endpoint by default, using
# OPENROUTER_API_KEY above -- no separate account needed. Set JEV_TRANSPORT=
# typesafe and TYPESAFE_API_KEY to go direct instead. The model is pinned to
# typesafe/jev-1.13 on purpose; override with JEV_MODEL.
JEV_TRANSPORT=openrouter
# TYPESAFE_API_KEY=your_typesafe_api_key_here
JEV_JUNK_THRESHOLD=0.85
# Measured knee is between 32 and 64 concurrent callers; 24 stays under it.
JEV_MAX_CONCURRENCY=24
# Paragraph-level filtering inside documents the filter keeps: off | shadow | on.
# shadow prints every block it would remove and removes nothing. A block is only
# ever dropped as part of a confident run at a document's edge, or a run of 3+.
JUNK_BLOCK_FILTER=off
JEV_BLOCK_THRESHOLD=0.9

# The narration director: JEV reads each paragraph with its neighbours and
# chooses how it is performed (hushed, frantic, tender, shouted...); CosyVoice
# narrates it so. Only on the GPU route (CosyVoice), never on the free CPU
# voices, which cannot be directed.
# About $0.17 for a 16-hour novel (measured 2026-10-08: $0.14 for 13.8 hours),
# and it counts inside VOXIE_BUDGET_16H: what it spent is taken off the GPU's
# share before a pod is rented. Every paragraph is sent to OpenRouter.
#   auto  on when OPENROUTER_API_KEY is set and TTS_PROVIDER=cosyvoice (default)
#   jev   always, and stop if the key is missing
#   off   never
NARRATION_DIRECTOR=auto

# --- The GPU route (measured 2026-09-26) ----------------------------------------
# CosyVoice3 on the prebaked vLLM image (the public RunPod template, running
# ghcr.io/smukoko/cosyvoice-tts:4.1). Measured 2026-10-07 with the narration
# director: an RTX A5000 at 9.1x realtime, about $0.50 for a sixteen-hour novel
# on one pod, an hour on three for about $0.65. To use it,
# uncomment TTS_PROVIDER, POD_COUNT and RUNPOD_TRANSPORT, and fill in the
# RunPod settings and TTS_API_TOKEN above (or TTS_URL for your own GPU).
# TTS_PROVIDER=cosyvoice
# A narrator in voices/ (python librerian_engine_v3.py --list-voices). Add your
# own with `voxie voice-add` (or the Voxie setup page) -- only with the speaker's consent.
# Unset with one voice added: that voice is used.
# COSY_VOICE=my_voice
# Callers per pod. vLLM batches them; 8 is the measured knee (16 adds 0.5%).
COSY_MAX_WORKERS=8
# Server processes per pod. 1 for the vLLM image: without this line the per-card
# table sends 4-8, which puts several vLLM engines on one GPU.
POD_API_WORKERS=1
# POD_COUNT=3
# RUNPOD_TRANSPORT=tcp
# When JEV is unreachable (a spent key, an outage), finish the book on ai_brain
# rather than stopping. none = stop instead.
JUNK_FALLBACK=ai_brain

# --- Gateway (the server running librerian_gateway_v3.py) ---------------------
# KOReader's "Register" button. Off: accounts come from
#   docker exec librarian_server python tools/gateway_admin.py add-user <name>
# ALLOW_REGISTRATION=0
# Encrypts each account's own Audiobookshelf token at rest (core/abs_settings.py).
# Gateway only. Create it without printing it:
#   python3 -c "import base64,secrets;print('LIBRA_SECRET_KEY='+base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())" >> .env
# LIBRA_SECRET_KEY=
# Whether this gateway stores and serves book files (the OPDS catalogue). A
# hosted sync service sets 0 and keeps maps and positions only.
# SERVE_BOOKS=1
